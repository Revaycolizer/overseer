{
  "name": "overseer-client",
  "version": "0.2.0",
  "description": "TypeScript client for the Overseer AI orchestration platform \u2014 zero dependencies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "dist-cjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "client",
    "overseer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/revaycolizer/overseer.git"
  },
  "homepage": "https://github.com/revaycolizer/overseer",
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
