{
  "name": "overseer-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Overseer AI orchestration platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "client",
    "overseer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/revaycolizer/overseer.git"
  },
  "homepage": "https://github.com/revaycolizer/overseer",
  "dependencies": {
    "ky": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
