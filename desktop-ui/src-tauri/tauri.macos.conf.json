{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Overseer",
        "width": 440,
        "height": 680,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "widget",
        "title": "Overseer Widget",
        "width": 430,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "shadow": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
